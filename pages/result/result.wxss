.summary-card {
  background: linear-gradient(135deg, #4A90D9 0%, #357ABD 100%);
  color: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 20rpx;
  text-align: center;
}

.summary-title {
  font-size: 28rpx;
  opacity: 0.9;
}

.summary-amount {
  font-size: 56rpx;
  font-weight: bold;
  margin: 20rpx 0;
}

.summary-detail {
  font-size: 26rpx;
  opacity: 0.8;
  display: flex;
  justify-content: center;
  gap: 40rpx;
}

.yearly {
  margin-top: 20rpx;
  font-size: 24rpx;
  background: rgba(255,255,255,0.2);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
  display: inline-block;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row:last-child {
  border-bottom: none;
}

.detail-table {
  width: 100%;
}

.detail-header, .detail-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 10rpx;
  font-size: 26rpx;
}

.detail-header {
  color: #999;
  border-bottom: 1rpx solid #eee;
}

.detail-row {
  border-bottom: 1rpx solid #f5f5f5;
}

.detail-row text {
  flex: 1;
  text-align: center;
}

.detail-row text:first-child {
  text-align: left;
}

.diff {
  color: #e74c3c;
  font-weight: bold;
}

.detail-total {
  text-align: right;
  padding: 16rpx;
  color: #4A90D9;
  font-weight: bold;
}

.btn-secondary {
  background: #fff;
  color: #4A90D9;
  border: 2rpx solid #4A90D9;
  border-radius: 12rpx;
  padding: 24rpx;
  text-align: center;
  font-size: 28rpx;
  margin-top: 20rpx;
}